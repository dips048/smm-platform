{
  "name": "@smm/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "husky",
    "dev": "nx run-many -t serve -p api worker admin-web --parallel=5",
    "dev:all": "nx run-many -t serve -p api worker admin-web donor-portal kiosk --parallel=10",
    "dev:api": "nx serve api",
    "dev:worker": "nx serve worker",
    "dev:admin": "nx serve admin-web",
    "dev:donor": "nx serve donor-portal",
    "dev:kiosk": "nx serve kiosk",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait",
    "db:logs": "docker compose logs -f",
    "db:tools": "docker compose --profile tools up -d --wait",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "nx format:write",
    "format:check": "nx format:check"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@fastify/sensible": "~6.0.2",
    "fastify": "~5.2.1",
    "fastify-plugin": "~5.0.1",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.6.0",
    "@analogjs/vitest-angular": "~2.6.0",
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nx/angular": "23.2.0",
    "@nx/esbuild": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/node": "23.2.0",
    "@nx/vite": "23.2.0",
    "@nx/vitest": "23.2.0",
