{
  "name": "domain",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domain/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:domain"],
  "// targets": "to see all targets run: nx show project domain --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p {projectRoot}/tsconfig.lib.json",
          "tsc --noEmit -p {projectRoot}/tsconfig.spec.json"
        ]
      }
    }
  }
}
