{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "importHelpers": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@smm/contracts": ["./libs/contracts/src/index.ts"],
      "@smm/domain": ["./libs/domain/src/index.ts"],
      "@smm/db": ["./libs/db/src/index.ts"],
      "@smm/ui": ["./libs/ui/src/index.ts"],
      "@smm/data-access": ["./libs/data-access/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
