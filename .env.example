# Local development settings. Copy to .env (git-ignored) and adjust if needed:
#   cp .env.example .env
# Docker Compose reads .env for docker-compose.yml, and Nx loads it into every
# task (serve, test, ...). Never put real secrets in this file.

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development

# --- API (apps/api) ----------------------------------------------------------
# Interface and port the Fastify server listens on. Do not use plain HOST/PORT
# here: Nx loads this file into every task, and the Angular dev servers would
# pick PORT up as well.
API_HOST=localhost
API_PORT=3000

# --- Postgres (docker-compose.yml `postgres`) --------------------------------
# Credentials the container is created with. Changing them later needs
# `pnpm db:reset`, because Postgres only reads them on first start.
POSTGRES_USER=smm
POSTGRES_PASSWORD=smm
POSTGRES_DB=smm
# Host port Postgres is published on (change if 5432 is taken).
POSTGRES_PORT=5432
# Connection string used by the API, worker (pg-boss) and Drizzle.
# Keep it in sync with the four values above.
DATABASE_URL=postgres://smm:smm@localhost:5432/smm

# --- Email (docker-compose.yml `mailpit`) ------------------------------------
# Outgoing SMTP. Locally this is Mailpit, which accepts any login and keeps
# every message; nothing reaches a real inbox.
SMTP_HOST=localhost
SMTP_PORT=1025
# Sender address for receipts and notifications.
EMAIL_FROM="Shri Mangal Mandir <no-reply@smm.localhost>"
# Host port for the Mailpit web UI.
MAILPIT_UI_PORT=8025

# --- pgAdmin (optional, `docker compose --profile tools up -d`) --------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@smm.localhost
PGADMIN_PASSWORD=admin
